# ClipForge Configuration
# Copy this to .env and fill in your values

# App Settings
APP_NAME=ClipForge
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this

# Database (SQLite - no external service needed)
DATABASE_URL=sqlite+aiosqlite:///./clipforge.db

# File Storage
UPLOAD_DIR=./uploads
CLIPS_DIR=./clips
TEMP_DIR=./temp

# Video Processing
MAX_VIDEO_SIZE_MB=500
CLIP_MIN_DURATION=15
CLIP_MAX_DURATION=60
MAX_CLIPS_PER_VIDEO=10

# FFmpeg (usually available system-wide)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Twitter/X OAuth 2.0 (Free - developer.twitter.com)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:8000/api/auth/twitter/callback

# Google/YouTube OAuth 2.0 (Free - console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# TikTok OAuth 2.0 (Free - developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_CALLBACK_URL=http://localhost:8000/api/auth/tiktok/callback

# Redis (Optional - for background tasks)
# If not set, tasks run in-process
REDIS_URL=
USE_CELERY=false
